rules_version = '2';

// Security rules for Attendance Pro.
// Paste into Firebase Console → Firestore Database → Rules → Publish
// (or deploy with `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('active', true) != false; }
    function isAdmin() { return isActive() && me().get('role', '') == 'admin'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function owns() { return isActive() && resource.data.employeeId == request.auth.uid; }
    function createsOwn() { return isActive() && request.resource.data.employeeId == request.auth.uid; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if isAdmin();
      // Managers can edit anything; staff may only update their own live location.
      allow update: if isAdmin() || (isSelf(uid) && isActive() && onlyChanges(['lastLocation']));

      // GPS trail while on duty
      match /track/{pointId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && isActive();
        allow update, delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------- sites
    match /sites/{siteId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      // Staff can update progress % from the Site Update tab.
      allow update: if isAdmin() || (isActive() && onlyChanges(['progress', 'progressUpdatedAt']));
    }

    // ------------------------------------------------------------ schedules
    match /schedules/{id} {
      allow read: if isAdmin() || owns();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------- attendance
    match /attendance/{id} {
      allow read: if isAdmin() || owns();
      allow create: if isAdmin() || (createsOwn() && request.resource.data.status == 'open');
      // Staff may only close their own open session (check-out fields).
      allow update: if isAdmin() || (owns() && resource.data.status == 'open'
                      && request.resource.data.status == 'closed'
                      && request.resource.data.employeeId == resource.data.employeeId
                      && onlyChanges(['checkOut', 'checkOutServer', 'outLat', 'outLng', 'outAccuracy',
                                      'outDistance', 'outOutside', 'durationMin', 'status', 'mocked', 'note']));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------- site updates
    match /siteUpdates/{id} {
      allow read: if isActive();
      allow create: if isAdmin() || createsOwn();
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------- petty
    match /petty/{id} {
      allow read: if isAdmin() || owns();
      // Staff entries always start as pending.
      allow create: if isAdmin() || (createsOwn() && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin() || (owns() && resource.data.status == 'pending');
    }

    // ------------------------------------------------------------- off days
    match /offDays/{id} {
      allow read: if isAdmin() || owns();
      allow create: if isAdmin() || (createsOwn() && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin() || (owns() && resource.data.status == 'pending');
    }
  }
}
